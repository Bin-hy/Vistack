# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.go]
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# =========================
# TOML 文件
# =========================
[*.toml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# =========================
# JSON 文件
# =========================
[*.json]
indent_style = space
indent_size = 2

# =========================
# YAML 文件
# =========================
[*.yml]
indent_style = space
indent_size = 2

# =========================
# Markdown 文件
# =========================
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# =========================
# Vue / HTML / CSS / JS
# =========================
[*.{vue,html,css,scss,js,ts}]
indent_style = space
indent_size = 2
